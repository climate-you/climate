# Heartbeat monitoring (installed as /etc/climate/heartbeat.env, mode 0600,
# by scripts/deploy/install_ops.sh, which never overwrites an existing copy).

# Ping URL of your heartbeat check for disk space (healthchecks.io format; see
# "External monitors" in docs/runbooks/deployment.md). It is the check's only
# credential -- anyone holding it can ping -- so it is never committed.
# Leave empty to install the timer without pinging anything.
DISK_HEARTBEAT_URL=

# Ping /fail (alert) when / has less than this many GB free.
DISK_MIN_FREE_GB=5
